{
  "name": "ibratv",
  "version": "2.1.0",
  "description": "IBRATV — مشغل تلفزيون مباشر بواجهة زجاجية حمراء",
  "main": "electron/main.cjs",
  "author": "Ibrahim Al-Khazraji (IBRAPROGRAM)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ibrata2.ibratv",
    "productName": "IBRATV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "logo.png",
      "logo-small.png",
      "icon.svg",
      "vendor/**/*",
      "fonts/**/*",
      "build/icon.png",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IBRATV",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
